# Release Signing Configuration Example
# Copy this file to 'keystore.properties' (or 'key.properties') and fill in your credentials.
# NOTE: 'keystore.properties' is ignored by git and will never be committed.

storeFile=/absolute/path/to/your-release-key.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
